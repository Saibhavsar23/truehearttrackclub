rules_version = '2';

// All writes happen through Cloud Functions (Admin SDK), never directly from browsers.
// Browsers may only READ: public catalog data, and (for administrators) operational data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && 'admin' in request.auth.token && request.auth.token.admin == true;
    }

    // Public catalog: only active products. Admins can see everything.
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if false;

      // Public variants are readable when the variant and its product are active. (inventory/* is legacy and unused.)
      match /variants/{variantId} {
        allow read: if isAdmin() ||
          (resource.data.active == true &&
           get(/databases/$(database)/documents/products/$(productId)).data.active == true);
        allow write: if false;
      }
    }

    // Public, non-sensitive store settings (fulfillment options, checkout notice).
    match /settings/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Operational data: administrators only.
    match /inventory/{id}      { allow read: if isAdmin(); allow write: if false; }
    match /orders/{id}         { allow read: if isAdmin(); allow write: if false; }
    match /mail/{id}           { allow read: if isAdmin(); allow write: if false; }
    match /storeSchedules/{id} { allow read: if isAdmin(); allow write: if false; }

    // Internal bookkeeping: nobody from the client.
    // Secrets (the Make email webhook URL). Not readable by anyone in a browser, admins included; only Cloud Functions touch it.
    match /private/{id}     { allow read, write: if false; }
    match /counters/{id}    { allow read, write: if false; }
    match /idempotency/{id} { allow read, write: if false; }
    match /rateLimits/{id}  { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
